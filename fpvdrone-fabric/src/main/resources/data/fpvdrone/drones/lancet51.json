{
  // ═══════════════════════════════════════════════════════
  // FPV Drone — Drone: lancet51 («Ланцет» / ZALA Lancet-3, izdeliye 51)
  // Bundled mod resource. File name (lancet51) is the drone id.
  //
  // Russian loitering munition, launched from the RAMP block exactly like the
  // FP-1 — flies as a LoiteringMunitionEntity with guidance "pilotable" (map
  // route planning + optional first-person manual control through its fixed
  // forward camera). Unlike the FP-1 it is a small, light, electric-motor
  // pusher-prop airframe — see BaseWeightGrams / Engine below.
  //
  // Real-world reference figures (izdeliye 51, the larger/heavier Lancet
  // variant vs. the 3kg-warhead izdeliye 52): MTOW ~12kg, ~1m wingspan,
  // search/cruise speed 80-110 km/h, terminal-dive speed up to ~300 km/h,
  // 40km range, 40-60min endurance, ~5kg HEAT/frag warhead (~200mm
  // penetration). In-game values below are scaled for playability where the
  // raw real-world number would be unplayable (e.g. terminal dive speed).
  // ═══════════════════════════════════════════════════════

  "DisplayName": "item.fpvdrone.lancet51_drone",

  // Item that represents this drone (tooltip icon rows resolve through this).
  "Item": "fpvdrone:lancet51_drone",

  // ── Tooltip icon rows (curated, not auto-derived) ──
  // No "Batteries"/"Projectiles" list (own inline warhead; runs off the same
  // Fuel Can flight-duration budget as every LoiteringMunitionEntity —
  // burnFuel() is generic and unconditional regardless of the electric-motor
  // flavour text above), so the auto-derive default would show nothing here.
  // The BetaFlight programmer right-clicked on the airframe opens the map
  // route planner (LoiteringMunitionEntity#interact, shared by every variant)
  // — optional since an empty-hand right-click opens the same planner.
  // No "Обязательно"/fuel_can row: EnergySource is "battery" (sealed, non-swappable,
  // forced to a full charge whenever the airframe enters the world un-flown) — this
  // airframe never touches a FuelCanItem at all, unlike the fuel-tank FP-1/Lytui/Orlan.
  "Tooltip": {
    "Sections": [
      { "Source": "Explicit", "Items": ["fpvdrone:ramp"], "LabelKey": "tooltip.fpvdrone.required" },
      { "Source": "Explicit", "Items": ["fpvdrone:betaflight"], "LabelKey": "tooltip.fpvdrone.optional" }
    ]
  },

  // pilotable = map route + first-person manual flight, same tier as the FP-1.
  "Guidance": "pilotable",

  // SBM (poly-mesh capable) geo model + entity texture. Lives under
  // bedrock_geo/ (NOT geo/) so GeckoLib's bulk bake never touches the mesh.
  "Model": "bedrock_geo/lancet51.geo.json",
  "Texture": "textures/entity/lancet51.png",

  // ── 3D OBB collision (data-driven) ──
  // No "wheels" bone (ramp-launched only, never a wheeled ground launch).
  "Collision": {
    "Model": "geo/collision/lancet51.geo.json",
    "Enabled": true
  },

  // Airframe mass in GRAMS. Real Lancet-51 MTOW is ~12 kg — much lighter than
  // the FP-1's 200 kg, so it rides the ambient wind far more (WindField.
  // airframeWindFactor: acceleration ∝ 1/mass), which is realistic for an
  // airframe this small.
  "BaseWeightGrams": 12000,

  "DroneName": "Ланцет-51",

  // ── Looping engine sound (client, OpenAL) ──
  // Placeholder: reuses the FP-1's distance-banded engine sample set (no
  // dedicated quiet-electric-motor sample exists yet). Real Lancet uses a
  // quiet electric pusher motor, not the FP-1's loud two-stroke — volume
  // trimmed down and range shortened versus the FP-1 as a rough approximation
  // until a proper sound asset is recorded.
  "Sounds": {
    "MaxRange": 220,
    "Volume": 1.0,
    "CrossFadeWidth": 80,
    "Layers": [
      { "SoundId": "fp_1lowrange",    "MaxRange": 70 },
      { "SoundId": "fp_1middlerange", "MaxRange": 150 },
      { "SoundId": "fp_1farrange",    "MaxRange": 220 }
    ]
  },

  // Single pusher rotor (bone "rotor" in the mesh, tail-mounted) — same as
  // the FP-1's render path. No quad propeller-blur, no takeoff brick puff.
  "Render": {
    "Kirpichiki": false,
    "PropellerBlur": false
  },

  "DamageZones": {
    "Core": { "Hp": 150, "ExplodeChance": 0.8 },
    "Peripheral": { "Hp": 600 }
  },

  // ── TaCZ small-arms damage override ──
  // Falls back to the shared default when omitted — see default.json's
  // identical comment for the full explanation. SuperbWarfare VehicleDamage
  // is NOT declared at the top level here: this airframe's inline Warhead
  // below already declares its own (see IVehicleDamageSource's javadoc).

  // ── First-person camera (data-driven) ──
  // Fixed forward electro-optical camera (real Lancet uses daylight optics
  // for terminal guidance, not thermal like the in-game FP-1) — thermal is
  // left off. ZALA selects a separate procedural sight instead of the analog
  // MAX7456 overlay used by ordinary FPV craft.
  "Camera": {
    "FovDegrees": 70,
    "ShowOsd": true,
    "OsdProfile": "zala",
    "Gimbal": false,
    "Thermal": false,

    // First-person viewpoint offset (blocks, airframe-local: forward/up/right), matching THIS
    // airframe's own "camera" bone pivot in bedrock_geo/lancet51.geo.json ([0, 2, -28] px —
    // Blockbench -Z = forward, so CamFwd = 28/16, CamUp = 2/16). Every munition's nose camera
    // bone sits at a different pivot; without its own values here a munition falls back to the
    // FP-1's bone position (DroneDefinition.DroneCamera's default), which put the Lancet's
    // actual first-person viewpoint at a point that no longer matches its own model after the
    // "camera" bone was moved in Blockbench.
    "CamFwd": 1.75,
    "CamUp": 0.125,
    "CamSide": 0,

    // Real ZALA seeker head traverse: a nose-mounted gimbal, not an independent turret — it
    // turns onto the designated point relative to the airframe's OWN nose heading, and pins at
    // the cone edge (rather than losing the target) once that offset is exceeded. Up is a rough
    // estimate (picked the midpoint of a 10-25 deg guess); down is capped short of straight-down
    // ("can't look under itself").
    "GimbalLimits": {
      "YawLeftDeg": 45,
      "YawRightDeg": 45,
      "PitchUpDeg": 20,
      "PitchDownDeg": 75
    }
  },

  // Electric motor: no combustion shake and no exhaust smoke (there is no
  // "engine" bone in this model either — the rear rotor is driven directly).
  "Engine": {
    "Enabled": false
  },

  // Dual-purpose zone on the fuselage's own dedicated "corpus" collision bone
  // (split out of "collision" from the strut/wing/tail cubes so the hover zone
  // is precisely the fuselage box, matching the FP-1's dedicated "main" bone
  // convention rather than the whole airframe including thin diagonal struts).
  // Offers Connect laptop only (see DroneServiceMenuProvider): the Lancet's
  // EnergySource below is "battery", not "fuel", so no Refuel action ever
  // appears — a real Lancet has a sealed internal battery, not a topped-up
  // fuel tank. Install/Uninstall rocket pod never appear since this airframe
  // declares no RocketPod block.
  "InteractZones": [
    { "Id": "service", "Bone": "corpus", "Content": "droneService" }
  ],

  // ── Loitering-munition flight profile (server-authoritative) ──
  // Only the fields that meaningfully differ from the engine's built-in
  // defaults are listed; everything else (manual-flight feel, wreck/solver
  // tuning, obstacle avoidance, etc.) falls back to the same defaults the
  // FP-1 also uses. Units: 1 block = 1 m, 1 tick = 0.05 s.
  "LoiterFlight": {
    // Cruise ≈ 108 km/h (1.5 blocks/tick) — the search/loiter run onto a designated
    // point, a touch above the real Lancet's ~90-100 km/h cruise so it doesn't feel
    // sluggish in-game. On the operator's terminal-dive command (B / bomb bind in
    // first person) the craft noses over and accelerates HARD to a ~4.2 blocks/tick
    // (≈ 302 km/h) terminal dive, the real munition's up-to-~300 km/h dive speed.
    // PropAccel raised to 0.20 (was 0.12) so the dive commit reaches terminal speed
    // in ~0.7s instead of ~1.1s — reported as "the dive feels too slow"; the craft
    // now snaps to full speed almost immediately once the attack angle is reached,
    // instead of visibly spooling up through the last stretch of the run-in.
    // Proximity is widened to 3.0 because at 4.2 blocks/tick the craft covers 4.2
    // blocks in a single tick, so a tighter detonation ring could be jumped over
    // between ticks.
    "CruiseSpeed": 1.5,
    "TerminalSpeed": 4.2,
    "Proximity": 3.0,
    "PropAccel": 0.20,

    // Small, light airframe — noticeably more agile than the FP-1 so it turns
    // onto a freshly-designated point quickly (the acquisition box snaps back
    // to centre faster). The turn RATE is set by the coordinated-turn physics
    // (turnRate = GPerTick2·tan(bank)/speed) capped by MaxTurnRate — and because
    // that formula divides by the craft's OWN speed, the terminal dive's 4.2
    // blocks/tick washes out the SAME GPerTick2 to under half the cruise-speed
    // turn rate (turnRate(4.2) ≈ turnRate(1.5) × 1.5/4.2), i.e. right when the
    // seeker needs to correct hardest (final line onto a moving vehicle) it had
    // the LEAST authority to do it — the real cause of "dives right past the
    // target". GPerTick2 raised from 0.09 to 0.20 keeps turnRate pinned at the
    // MaxTurnRate ceiling (4.5°/tick) through the ENTIRE speed range including
    // the 4.2 blocks/tick terminal dive (0.20·tan(60°)/4.2 → ~4.7°/tick, still
    // ≥ the cap), not just at cruise, so the final line onto a repositioning
    // target keeps full turn authority instead of flying an uncorrectable
    // straight line once terminal speed kicks in. BankGain raised so a small
    // heading error already commands a hard bank (snappy point-and-fly).
    "MaxBank": 60.0,
    "GPerTick2": 0.20,
    "MaxTurnRate": 4.5,
    "BankGain": 3.0,
    "RollRate": 4.5,

    // FPV-parity pre-impact freeze (see DroneDefinition.LoiterFlight.freezeLeadDistance,
    // consumed client-side by MunitionViewState.checkImminentImpactFreeze): the pilot's
    // camera freezes on its last frame once within this many blocks of the impact point,
    // held through the actual detonation. detonationChecks() only samples this once per
    // SERVER TICK, so the flag can only ever go true THIS MANY BLOCKS MINUS ONE TICK'S
    // TRAVEL before the real hit in the worst case — at the 4.2 blocks/tick terminal dive
    // speed that worst case eats up to ~4.2 blocks of the margin by itself. 7.0 keeps a
    // ~2.8-block worst-case margin (7.0 - 4.2) and up to the full 7.0 best-case — tuned
    // down from an earlier 10.0 per playtest feedback (7 blocks read as the right amount).
    "FreezeLeadDistance": 7.0,

    // ── Pitch authority (line-of-sight arc onto a designated point) ──
    // The Lancet's twin X-wings + X-tail make it very agile in pitch. Its ZALA
    // seeker flies a fixed-wing LINE-OF-SIGHT pursuit: the nose is aimed straight at
    // the designated 3D point (atan2(Δy, horiz)) and slewed there at PitchRate,
    // clamped to ±MaxPitch (±2× in the terminal dive). So MaxPitch = the steepest
    // climb/dive arc it will fly onto a point, and PitchRate = how fast the nose
    // tracks the sight-line. The FP-1 defaults (MaxPitch 35, PitchRate 1.5) are
    // sluggish for a point-and-fly seeker; a steeper limit + faster slew let it chase
    // the acquisition box vertically as hard as it banks onto it in yaw. (AltPitchGain
    // now only affects route-leg altitude-hold + obstacle avoidance, not the seeker.)
    "MaxPitch": 55.0,
    "PitchRate": 3.5,
    "AltPitchGain": 2.5,

    // ── First-person control scheme (data-driven) ──
    // The Lancet is NOT hand-flown with sticks like the FP-1. Its ZALA sight is a
    // point-and-fly seeker: a LEFT-CLICK on the feed designates a fixed world
    // point, the airframe autonomously banks/dives onto it, and throttle is fully
    // automatic (cruise en route, terminal dive as it closes). Flown with no
    // keyboard/controller. Every other manual-feel field is irrelevant in this
    // scheme (they tune the stick law), so only ControlScheme is set here.
    "Manual": {
      "ControlScheme": "click_designate"
    },

    // ── Power source (data-driven, DroneDefinition.LoiterFlight.energySource) ──
    // The real Lancet-51 is electric — a sealed internal battery, not the FP-1's
    // combustion engine — so it needs no FuelCanItem at all: it always installs on
    // the ramp and launches fully charged (see DroneServiceMenuProvider/RampEntity/
    // LoiteringMunitionEntity's usesFuelCan()), and simply glides down as a dud if
    // the battery ever runs out mid-flight (same as an FP-1 running dry).
    "EnergySource": "battery",

    // Capacity is the battery charge itself, in ticks — the ONLY thing that limits
    // flight duration (no separate hard-timeout safety net exists any more; the
    // airframe simply glides down as a dud once the battery runs dry, same as an
    // FP-1 running out of fuel). Real endurance is 40-60 minutes, but capped here at
    // a gameplay-tuned 20 minutes (24000 ticks) of electric flight.
    "Capacity": 24000,

    // ── Warhead — the drone IS the warhead ──
    // Real Lancet-51 (izdeliye 51) warhead is ~5 kg HEAT/fragmentation
    // (~200mm penetration) — much smaller than the FP-1's ~105kg payload, so
    // blast/fragment values are scaled down accordingly. ShapedChargeDamage
    // is kept close to the FP-1's: a shaped charge's penetration comes from
    // its liner geometry, not raw mass, matching the real munition's
    // reputation for precise anti-armor kills despite its small size.
    "Warhead": {
      "DisplayName": "item.fpvdrone.lancet51",
      "Behavior": "shrapnel",
      "ExplosionPower": 3.0,
      "FragmentCount": 40,
      "DetonationSpeed": 2.0,
      "ShapedChargeDamage": 450.0,
      "VehicleDamage": 700.0,
      "Stats": {
        "LethalRange": 1.5,
        "BaseDamage": 10.0,
        "ScaleDamage": 3.0,
        "DamageCap": 60.0,
        "BlastRadius": 8.0,
        "BlastDamage": 45.0,
        "KillZone": 4.0,
        "BlockPower": 1.0,
        "OpensDoors": true
      },

      // Reuse the TM-62's detonation particle preset (shaped-charge visual
      // family) rather than duplicating a whole particle list here.
      "particlesFrom": "tm62",

      // Placeholder: FP-1's detonation sound bank, trimmed down (smaller
      // charge) — range/volume reduced from the FP-1's 350/1.8.
      "Sounds": {
        "MaxRange": 250,
        "Volume": 1.4,
        "CrossFadeWidth": 80,
        "Layers": [
          { "SoundId": "bomb250_lowrange",    "MaxRange": 80 },
          { "SoundId": "bomb250_middlerange", "MaxRange": 165 },
          { "SoundId": "bomb250_farrange",    "MaxRange": 250 }
        ]
      }
    }
  },

  // ── Motion sync (how a FAR OBSERVER's client sees this munition, and how the
  //    PILOT's own view of it is smoothed — LoiteringMunitionEntity is server-
  //    authoritative even in first-person ride) ──
  // See fp1.json for what each field does. Same forward terrain lead — the Lancet
  // cruises slower than the FP-1 but dives considerably faster.
  //
  // SnapDistance is raised from the shared munition default (8.0) to cover the
  // terminal dive: SyncTuning.snapDistance's contract is "must exceed top speed x
  // the broadcast gap." TerminalSpeed 4.2 blocks/tick (~302 km/h, ~84 blocks/s)
  // already covers ~8.4 blocks in a single missed/delayed server tick (a 0.1s gap
  // instead of the usual 0.05s), which sat right at the old 8.0 threshold — so any
  // ordinary tick jitter during the dive triggered a hard positional snap instead of
  // CraftPrediction's normal smooth error-decay blend, felt as the craft lagging/
  // jerking specifically while diving (never at the slower 1.5 blocks/tick cruise).
  // 16.0 gives headroom for a couple of missed ticks in a row before snapping.
  "Sync": {
    "SnapDistance": 16.0,
    "TerrainLeadSeconds": 1.5
  }
}
