{
  // ═══════════════════════════════════════════════════════
  // FPV Drone — Projectile: 70mm_rocket (S-5-class unguided aviation rocket, NAR)
  // Bundled mod resource. File name (70mm_rocket) is the projectile id.
  // Fired from the FP-1's rocket pod tubes. Physics is a short initial impulse
  // (muzzle velocity along the tube's bore axis, added to the carrier's own
  // velocity — see "launch" below) followed by PURE BALLISTICS: gravity +
  // aerodynamic drag via the shared dropped-projectile pipeline, exactly like
  // any other released bomb/grenade. There is no sustained motor burn in the
  // physics — the "motor" block below is a purely cosmetic exhaust trail.
  // ═══════════════════════════════════════════════════════

  "DisplayName": "item.fpvdrone.70mm_rocket",

  // Mass added to the drone when a tube is loaded (grams). A real S-5-class
  // 70mm rocket is ~5 kg loaded.
  "WeightGrams": 5000,

  // Detonation behavior. Built-in: "shrapnel".
  "Behavior": "shrapnel",

  // ── Model & texture (client rendering) ──
  "Model": "geo/70mm_rocket.geo.json",
  "Texture": "textures/entity/70mm_rocket.png",

  // Explosion power (1-10): scales blast/shrapnel reach. Between the 40mm
  // grenade (1.5) and the TM-62 anti-tank mine (8.0).
  "ExplosionPower": 3.5,
  // Number of shrapnel rays cast on detonation (8-512).
  "FragmentCount": 200,
  // Minimum impact speed (m/s) that triggers detonation.
  "DetonationSpeed": 2.0,
  // Pure HE fragmentation warhead — no shaped charge.
  "ShapedChargeDamage": 0.0,
  // Contact-point HP against a data-driven-vehicle-damage-source target (see
  // ShrapnelExplosion.vehicleFalloff) — a real HE aviation rocket, mid-strength.
  "VehicleDamage": 350.0,

  // ── Damage profile ──
  "Stats": {
    "LethalRange": 2.2,
    "BaseDamage": 9.0,
    "ScaleDamage": 3.0,
    "DamageCap": 45.0,
    "BlastRadius": 9.0,
    "BlastDamage": 35.0,
    "KillZone": 3.0,
    "BlockPower": 0.3,
    "OpensDoors": true
  },

  // ── Fuze (post-release safety / arming delay) ──
  // Short — the muzzle impulse already carries it clear of the launching drone
  // within a couple ticks, unlike a released bomb that starts at zero relative speed.
  "Fuze": {
    "ArmingDelaySeconds": 0.2
  },

  // ── Tube-launch impulse ──
  // The one physics ingredient beyond a dropped bomb: a forward "kick" added to
  // the carrier's own velocity at the instant of firing. Not a realistic ~370
  // m/s (~18.5 blocks/tick), but fast enough that gravity's per-tick pull
  // (GRAVITY = 0.0245 blocks/tick^2) stays a small fraction of forward speed
  // over a normal engagement range, so the nose-weathervane (which faithfully
  // tracks the REAL velocity vector, not just the model) doesn't visibly droop
  // within the first few tens of blocks the way a slower muzzle velocity did.
  // Movement uses vanilla's own swept block collision (`move(MoverType.SELF, ..)`,
  // the same mechanism arrows/fireballs rely on at similar or higher speeds), so
  // there is no extra tunneling risk from raising this value.
  "Launch": {
    "MuzzleVelocity": 5.0,
    "DispersionDeg": 1.0
  },

  // ── In-flight motor exhaust (cosmetic only — does NOT feed physics) ──
  // Direct port of mtsofficialpack's own bulletrocket.json "rendering.particles"
  // list: of its ~30 particle entries, exactly ONE is gated on "!bullet_burntime"
  // (visible while the motor burns, i.e. in flight) — the "smoketrail" entry.
  // Everything else in that file is gated on "bullet_hit"/"bullet_hit_block"
  // (detonation-only; already covered by "particles" below). MTS additionally
  // shows a burning FLAME via animated MODEL geometry (the "flamei"/"flameo"
  // objects + emissive light), not a particle — this mod's particle system has
  // no equivalent for that, so it is intentionally not reproduced rather than
  // invented as a substitute particle.
  //
  // burnTicks matches MTS's "burnTime": 100 exactly (NOT "accelerationTime": 20,
  // which only bounds the physics acceleration curve MTS itself uses — we don't
  // use a sustained-burn physics model at all, see the file header).
  //
  // MTS's own spawningOrientation is "entity" with initialVelocity along its
  // LOCAL Z (tail-ward); this engine's FACING orientation is what actually
  // rotates a spawn-frame vector onto the supplied nose-relative direction (see
  // FpvParticle#orientLocal — ENTITY is not currently direction-aware here), so
  // MTS's local Z axis is remapped onto FACING's local Y here (same "away from
  // the tail" meaning, reusing the SAME rotation the ground-impact "break"
  // particles already rely on rather than adding a second orientation path).
  "Motor": {
    "BurnTicks": 100,
    "particles": [
      {
        "type": "generic",
        "spawningOrientation": "facing",
        "renderingOrientation": "player",
        "quantity": 1,
        "duration": 100,
        "durationRandomness": 50,
        "transparency": 0.5,
        "toTransparency": 0.001,
        "scale": 3.2,
        "toScale": 7.0,
        "ignoreCollision": true,
        "textureList": [
          "fpvdrone:textures/particles/big_smoke_0.png",
          "fpvdrone:textures/particles/big_smoke_1.png",
          "fpvdrone:textures/particles/big_smoke_2.png",
          "fpvdrone:textures/particles/big_smoke_3.png",
          "fpvdrone:textures/particles/big_smoke_4.png",
          "fpvdrone:textures/particles/big_smoke_5.png",
          "fpvdrone:textures/particles/big_smoke_6.png",
          "fpvdrone:textures/particles/big_smoke_7.png",
          "fpvdrone:textures/particles/big_smoke_8.png",
          "fpvdrone:textures/particles/big_smoke_9.png",
          "fpvdrone:textures/particles/big_smoke_10.png",
          "fpvdrone:textures/particles/big_smoke_11.png"
        ],
        "textureDelays": [10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10],
        "randomTexture": true,
        "colorList": ["C4C0BB", "B9B4AD", "D2D0CD", "ADA79F", "A39A8D", "99958F", "DDDBD8"],
        "randomColor": true,
        "spreadRandomness": [0.2, 0.2, 0.2],
        "initialVelocity": [0.0, 0.5, 0.0]
      }
    ]
  },

