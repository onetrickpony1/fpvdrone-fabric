  // ── Drop / free-fall aerodynamics ──
  // Fin-stabilized rocket body: lower drag and higher alignment stiffness/damping
  // than a dumb bomb, so it self-aligns to the airflow quickly and holds a flat
  // trajectory instead of tumbling.
  "Drop": {
    "Mass": 5.0,
    "DragCoefficient": 0.3,
    "CrossSection": 0.0038,
    "AlignStiffness": 3.5,
    "AngularDamping": 3.5,
    // DroppedBombRenderer applies a model authoring-frame yaw correction AFTER
    // orienting the model to the real travel/nose direction (see ModelYawDeg's
    // javadoc on ProjectileType.DropPhysics) — the shared default (180) was
    // tuned for the 40mm_explosive model, NOT this rocket's own freshly built
    // geo (whose single cube has its own baked "rotation": [0, 90, 0]). If the
    // rocket visually doesn't point along its actual flight path in-game, this
    // is the knob to fix it: try 0/90/180/270 until the nose tracks correctly.
    "ModelYawDeg": 0.0
  },

  // ── Detonation sound ──
  // Distance tuning taken from bulletrocket.json's own sound entries: close
  // full-volume out to ~90 blocks, fading to 0 by ~200; distant rises to ~0.8
  // by 160 and fades out by ~450.
  "Sounds": {
    "MaxRange": 450,
    "CrossFadeWidth": 70,
    "Volume": 1.6,
    "Layers": [
      { "SoundId": "rocketboom",          "MaxRange": 125 },
      { "SoundId": "rocketboom_distant",  "MaxRange": 450 }
    ]
  },

  // ── Launch (firing) sound ──
  // Distance tuning taken from gunrocketpod.json's own basic_ocp_rocket entries:
  // close full-volume out to ~50 blocks, fading to 0 by ~100; distant rises to
  // ~0.6 by 50-90 and fades out by ~150.
  "LaunchSounds": {
    "MaxRange": 150,
    "CrossFadeWidth": 40,
    "Volume": 1.0,
    "Layers": [
      { "SoundId": "basic_ocp_rocket",         "MaxRange": 70 },
      { "SoundId": "basic_ocp_rocket_distant", "MaxRange": 150 }
    ]
  },

  // ── Chunk streaming while in flight (server side) ──
  // This rocket leaves the tube at 5 blocks/tick (100 blocks/s), fast enough to outrun
  // chunk generation over unexplored terrain — and a chunk that has not finished
  // generating contributes NO collision at all (vanilla skips a null chunk when
  // gathering block collisions), so the rocket would fly straight THROUGH a hill and
  // never detonate. Keeping a ticking disc 1.5 s of travel ahead (~150 blocks at muzzle
  // speed, shrinking as it slows) means the terrain is already generated when it gets
  // there. Cheap: it is one 5x5-chunk disc placed far ahead, NOT a bigger ring — ring
  // radius grows the footprint quadratically and would cause the very hitch it prevents.
  // Omit this block (like every other projectile does) for the default footprint.
  "Stream": {
    "TerrainLeadSeconds": 1.5
  }
}
