  // ── Drop / free-fall aerodynamics ──
  // The grenade inherits the drone's velocity at release, then free-falls under
  // gravity + quadratic air drag while its nose weathervanes toward the airflow.
  // A grenade is light and tumbly, so the alignment is weak and it damps slowly.
  "Drop": {
    // Mass (kg). RGD-5 ≈ 310 g.
    "Mass": 0.31,
    // Translational drag coefficient (Cd) — roughly a small sphere.
    "DragCoefficient": 0.47,
    // Frontal cross-section area (m^2) for a ~58 mm diameter body.
    "CrossSection": 0.0026,
    // Weak aerodynamic alignment — a grenade tumbles rather than weathervanes.
    "AlignStiffness": 0.2,
    // Low angular damping so the tumble persists.
    "AngularDamping": 1.0
  },

  // ── Grenade fuse / bounce / roll ──
  // Presence of this block makes the dropped projectile a TIME-FUZED grenade:
  // it does NOT explode on impact. It bounces softly off blocks, rolls to rest,
  // ricochets off entity hitboxes, and detonates only when the fuse expires.
  "Grenade": {
    // Fuse delay (ticks) from release to detonation. The real RGD-5 UZRGM fuze
    // is 3.2–4.2 s; 80 ticks = 4.0 s.
    "FuseTicks": 80,
    // Coefficient of restitution (0..1) for a block bounce. Low = soft, dead.
    "Restitution": 0.35,
    // Speed (blocks/tick) below which an impact stops bouncing and the grenade
    // settles — higher = fewer little bounces, settles sooner.
    "MinBounceSpeed": 0.12,
    // Per-tick horizontal speed kept while rolling on the ground (0..1). Lower
    // settles faster; a grenade is not spherical so it stops quickly.
    "GroundFriction": 0.4,
    // Coefficient of restitution (0..1) when ricocheting off an entity hitbox.
    "EntityRestitution": 0.25
  },

  // ── Melee deflection ("knock it away with your hands") ──
  // Like 40mm_explosive: a player can bat the falling grenade aside by hitting its
  // hitbox. Modelled as an inelastic strike — incoming velocity reflected about
  // the attacker→grenade normal (scaled by restitution) plus a swing impulse
  // along the look direction, divided by mass.
  "Deflect": {
    // Master switch for deflection.
    "Enabled": true,
    // Coefficient of restitution (0..1) for the reflected velocity component.
    "Restitution": 0.45,
    // Swing impulse (kg·block/tick) before mass division.
    "MaxImpulse": 0.08,
    // Item id required to deflect; "" = any item or a bare hand.
    "RequiredTool": "",
    // Ticks the grenade stays disarmed against the deflector after a hit.
    "ArmDelayAfterDeflect": 4
  },

  // ── Detonation sound ──
  // Two-layer crossfade: the near layer plays full volume out to the middle of
  // the crossfade window, then equal-power crossfades to the far layer, which
  // fades to silence by MaxRange. A small grenade is audible over a tighter
  // footprint than the RPG-7's default (see SoundProfile.DEFAULT).
  "Sounds": {
    "MaxRange": 110,
    "CrossFadeWidth": 28,
    "Volume": 1.3,
    "Layers": [
      { "SoundId": "bomblet_close",   "MaxRange": 32 },
      { "SoundId": "bomblet_distant", "MaxRange": 110 }
    ]
  }
}
