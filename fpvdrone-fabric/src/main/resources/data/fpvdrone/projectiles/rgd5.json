  // ═══════════════════════════════════════════════════════
  // FPV Drone — Projectile: RGD-5
  // Bundled mod resource. File name (rgd5) is the projectile id.
  // Soviet RGD-5 anti-personnel fragmentation hand grenade: lighter than the
  // RPG-7, no shaped charge, smaller blast but a dense fragment spray.
  // ═══════════════════════════════════════════════════════

  // Display name translation key (or literal text).
  "DisplayName": "item.fpvdrone.rgd5",

  // Mass added to the drone when this projectile is carried (grams).
  "WeightGrams": 310,

  // Detonation behavior. Built-in: "shrapnel".
  "Behavior": "shrapnel",

  // ── Model & texture (client rendering) ──
  // GeckoLib model + texture for the payload mounted on the drone, relative to
  // assets/fpvdrone/. Placement is owned by the drone definition's projectile
  // entry (see data/fpvdrone/drones/*.json), never here.
  "Model": "geo/rgd5.geo.json",
  "Texture": "textures/entity/rgd5.png",

  // Explosion power (1-10): scales blast/shrapnel reach.
  "ExplosionPower": 2.0,
  // Number of shrapnel rays cast on detonation (8-512). Dense frag spray.
  "FragmentCount": 350,
  // Minimum impact speed (m/s) that triggers detonation.
  "DetonationSpeed": 2.0,
  // No shaped charge — RGD-5 is purely fragmentation.
  "ShapedChargeDamage": 0.0,
  // Contact-point HP dealt to a data-driven-vehicle-damage-source target (e.g. a
  // SuperbWarfare vehicle) on a direct ram/near-contact hit, falling off with
  // distance to 0 at BlastRadius (see ShrapnelExplosion.vehicleFalloff). Low —
  // a hand grenade barely dents armor.
  "VehicleDamage": 60.0,

  // ── Damage profile ──
  "Stats": {
    // Inner radius (blocks) of flat peak shrapnel damage.
    "LethalRange": 1.0,
    // Shrapnel peak base. peak = BaseDamage + ScaleDamage * ExplosionPower.
    "BaseDamage": 8.0,
    // Shrapnel peak added per unit of explosion power.
    "ScaleDamage": 3.0,
    // Max (non-instant-kill) damage to any single entity.
    "DamageCap": 40.0,
    // Blast-wave radius (blocks).
    "BlastRadius": 7.0,
    // Peak blast-wave damage at the edge of the kill zone.
    "BlastDamage": 25.0,
    // Inner radius (blocks) where the blast wave is instant-kill.
    "KillZone": 1.5,
    // Vanilla TNT block-destruction scalar (0 = no blocks broken).
    "BlockPower": 0.0,
    // Force doors/trapdoors/gates open within the blast.
    "OpensDoors": true
  },

