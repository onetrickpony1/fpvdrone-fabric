  // ── Drop / free-fall aerodynamics ──
  // Used by the dropped-bomb entity's physics. The bomb inherits the drone's
  // velocity at release, free-falls under gravity + quadratic drag, and the
  // nose weathervanes toward the airflow. Restoring torque scales with dynamic
  // pressure (speed^2), so at low speed it falls roughly as released and only
  // noses down once it has built up speed.
  "Drop": {
    // Mass (kg) used in the fall integration.
    "Mass": 0.25,
    // Translational drag coefficient (Cd).
    "DragCoefficient": 0.55,
    // Frontal cross-section area (m^2).
    "CrossSection": 0.0013,
    // Aerodynamic alignment stiffness: torque ~ stiffness * speed^2 * sin(err).
    "AlignStiffness": 0.9,
    // Angular damping (per second) — higher settles the oscillation faster.
    "AngularDamping": 2.2
  },

  // ── Melee deflection ("batting away") ──
  // A player can knock the falling bomb aside by hitting its hitbox. Modelled as
  // an inelastic bat strike: the incoming velocity is reflected about the
  // attacker→bomb contact normal (scaled by restitution), then a swing impulse
  // along the attacker's look direction is added and divided by the bomb's mass.
  "Deflect": {
    // Master switch for deflection.
    "Enabled": true,
    // Coefficient of restitution (0..1) for the reflected velocity component.
    "Restitution": 0.45,
    // Swing impulse (kg·block/tick) before mass division. mass=0.25 => ~0.32 block/tick kick,
    // then clamped by the entity's post-hit speed cap (~9 m/s) for an incoming fast bomb.
    "MaxImpulse": 0.08,
    // Item id required to deflect; "" = any item or a bare hand.
    "RequiredTool": "",
    // Ticks the bomb stays disarmed against the deflector after a hit.
    "ArmDelayAfterDeflect": 4
  },

  // ── Detonation sound ──
  // The smallest charge here — tightest audible footprint. See rgd5.json for a
  // full description of the two-layer crossfade shape.
  "Sounds": {
    "MaxRange": 96,
    "CrossFadeWidth": 26,
    "Volume": 1.2,
    "Layers": [
      { "SoundId": "bomblet_close",   "MaxRange": 30 },
      { "SoundId": "bomblet_distant", "MaxRange": 96 }
    ]
  }
}
