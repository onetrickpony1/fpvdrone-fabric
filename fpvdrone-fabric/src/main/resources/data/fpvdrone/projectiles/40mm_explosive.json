 {
  // ═══════════════════════════════════════════════════════
  // FPV Drone — Projectile: 40mm_explosive (40mm VOG-type drone-drop grenade)
  // Bundled mod resource. File name (40mm_explosive) is the projectile id.
  // A small 40mm VOG-style fragmentation grenade carried in pairs on the
  // Mavic's drop mount. Released (not rammed into a target) via the bomb-drop key; it
  // free-falls, then weathervanes nose-down under aerodynamic drag and
  // detonates on impact.
  // ═══════════════════════════════════════════════════════

  // Display name translation key (or literal text).
  "DisplayName": "item.fpvdrone.40mm_explosive",

  // Mass added to the drone when this projectile is carried (grams).
  "WeightGrams": 250,

  // Detonation behavior. Built-in: "shrapnel".
  "Behavior": "shrapnel",

  // ── Model & texture (client rendering) ──
  // Authored in a neutral frame (left mount station coords). Placement on the
  // drone is owned by the drone definition's bomb-bay stations. The texture is
  // the shared Mavic atlas (the bomb UVs live inside it).
  "Model": "geo/40mm_explosive.geo.json",
  "Texture": "textures/entity/dji_mavic_3pro.png",

  // Explosion power (1-10): scales blast/shrapnel reach. Small grenade.
  "ExplosionPower": 1.5,
  // Number of shrapnel rays cast on detonation (8-512).
  "FragmentCount": 200,
  // Minimum impact speed (m/s) that triggers detonation. 0 = any ground touch.
  "DetonationSpeed": 0.0,
  // No shaped charge — pure fragmentation.
  "ShapedChargeDamage": 0.0,
  // Contact-point HP against a data-driven-vehicle-damage-source target (see
  // ShrapnelExplosion.vehicleFalloff) — a small HE grenade, modest against armor.
  "VehicleDamage": 90.0,

  // ── Damage profile ──
  "Stats": {
    "LethalRange": 2.0,
    "BaseDamage": 6.0,
    "ScaleDamage": 2.0,
    "DamageCap": 30.0,
    "BlastRadius": 5.0,
    "BlastDamage": 18.0,
    "KillZone": 4.0,
    "BlockPower": 0.0,
    "OpensDoors": true
  },

  // ── Fuze (post-release safety / arming delay) ──
  // The bomb cannot detonate for this long after leaving the drop rack, so it
  // won't blow up the instant it's released on or next to the launching drone.
  // Authored in seconds. Omit the whole block for the near-instant default.
  "Fuze": {
    "ArmingDelaySeconds": 1.5
  },

